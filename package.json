{
  "name": "bikes-v2",
  "version": "0.0.1",
  "private": true,
  "description": "Zombie-apocalypse ebike survival in Mesa AZ",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "quality": "tsc --noEmit && vitest run && vite build",
    "map:mesa": "node scripts/fetch-mesa-map.mjs",
    "model:ranch": "blender --background --python tools/models/ranch_7620.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-shit/bikes-v2.git"
  },
  "keywords": [
    "three.js",
    "bike",
    "game",
    "3d"
  ],
  "author": "Jordan Partridge",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/the-shit/bikes-v2/issues"
  },
  "homepage": "https://bikes-v2.jordanpartridge.us",
  "dependencies": {
    "three": "^0.160.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.4",
    "happy-dom": "^20.11.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
